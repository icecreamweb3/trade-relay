//@version=6
indicator(
     "美股早盘区间 09:30–11:00 ET · 今日/全部 v2",
     shorttitle = "US Opening Range",
     overlay = true,
     max_lines_count = 300,
     max_boxes_count = 300,
     max_labels_count = 100
)

// 与 Trade Relay K 线窗口保持一致：
//   TR = 早盘区间高度（ORH - ORL），不是 Pine 内置的 True Range。
//   上方目标 = ORH + 1×/2×TR。
//   下方目标 = ORL - 1×/2×TR。
//
// 显示规则：
//   1. 默认只绘制纽约当地今日的区间；可在设置中切换为全部交易日。
//      每个交易日使用独立的水平区间，不连接相邻两天。
//   2. 纽约时间 09:30–11:00 使用该时段最终 ORH/ORL 绘制完整矩形。
//   3. 区间从美盘早盘开始延续到北京时间次日 12:00。
//   4. 在 ORH 上边界下方显示 ORH - ORL 的区间振幅。
//   5. 在其下方显示美盘开盘当日北京时间 08:00 至当前（最晚次日 12:00）的今日振幅。
//   6. 价格标签只显示在屏幕内最近的一组，避免遮挡 K 线。

string GROUP_SESSION = "早盘区间"
string GROUP_DISPLAY = "显示设置"

string sessionInput = input.session(
     "0930-1100",
     "统计时段（纽约时间）",
     group = GROUP_SESSION
)

string activeDays = input.string(
     "23456",
     "有效星期",
     tooltip = "1=周日，2=周一，…，7=周六；默认周一至周五。若用于全天候市场可改为 1234567",
     group = GROUP_SESSION
)

bool showAllTradingDays = input.bool(
     false,
     "显示全部交易日美盘区间",
     tooltip = "默认关闭，仅显示纽约当地今日的美盘区间；开启后显示视口内全部交易日的历史美盘区间。",
     group = GROUP_DISPLAY
)

bool showOpeningRange = input.bool(
     true,
     "显示早盘高低点",
     group = GROUP_DISPLAY
)

bool showUpperTargets = input.bool(
     false,
     "显示上方 1×/2× TR",
     group = GROUP_DISPLAY
)

bool showLowerTargets = input.bool(
     false,
     "显示下方 1×/2× TR",
     group = GROUP_DISPLAY
)

bool showLabels = input.bool(
     true,
     "显示最新区间价格标签",
     group = GROUP_DISPLAY
)

bool showRangeDifference = input.bool(
     true,
     "显示区间振幅",
     tooltip = "在 ORH 上边界下方显示 ORH - ORL 的区间振幅。",
     group = GROUP_DISPLAY
)

bool showMorningDifference = input.bool(
     true,
     "显示今日振幅",
     tooltip = "显示美盘开盘当日北京时间 08:00 至当前的最高价与最低价差值，统计最晚到次日 12:00。",
     group = GROUP_DISPLAY
)

// 使用纽约交易所当地时间，TradingView 会自动处理 EDT/EST 切换：
//   - 美国夏令时对应北京时间 21:30–23:00；
//   - 美国冬令时对应北京时间 22:30–次日 00:00。
// 此设置不受图表显示时区和品种交易所时区影响。
string SESSION_TIMEZONE = "America/New_York"
string DISPLAY_END_TIMEZONE = "Asia/Shanghai"
string sessionSpec = sessionInput + ":" + activeDays
int todaySessionDate = year(timenow, SESSION_TIMEZONE) * 10000
     + month(timenow, SESSION_TIMEZONE) * 100
     + dayofmonth(timenow, SESSION_TIMEZONE)

// 每个美盘区间固定显示到其北京时间日期的次日 12:00。
sessionDisplayEnd(int sessionStart) =>
    timestamp(
         DISPLAY_END_TIMEZONE,
         year(sessionStart, DISPLAY_END_TIMEZONE),
         month(sessionStart, DISPLAY_END_TIMEZONE),
         dayofmonth(sessionStart, DISPLAY_END_TIMEZONE) + 1,
         12,
         0
    )

// 区块开始日期当天的北京时间 08:00，是高低差统计的起点。
sessionMorningStart(int sessionStart) =>
    timestamp(
         DISPLAY_END_TIMEZONE,
         year(sessionStart, DISPLAY_END_TIMEZONE),
         month(sessionStart, DISPLAY_END_TIMEZONE),
         dayofmonth(sessionStart, DISPLAY_END_TIMEZONE),
         8,
         0
    )

bool inOpeningRange = not na(
     time(timeframe.period, sessionSpec, SESSION_TIMEZONE)
)
bool openingRangeStarted = inOpeningRange and not inOpeningRange[1]

// 独立累计北京时间每日 08:00 起的高低点，使美盘区块在 21:30/22:30
// 创建时能够带入当天 08:00 至开盘前已经形成的行情范围。
int currentBeijingEight = timestamp(
     DISPLAY_END_TIMEZONE,
     year(time, DISPLAY_END_TIMEZONE),
     month(time, DISPLAY_END_TIMEZONE),
     dayofmonth(time, DISPLAY_END_TIMEZONE),
     8,
     0
)
int activeMeasurementStart = time >= currentBeijingEight
     ? currentBeijingEight
     : currentBeijingEight - 24 * 60 * 60 * 1000
var int trackedMeasurementStart = na
var float trackedMeasurementHigh = na
var float trackedMeasurementLow = na

if na(trackedMeasurementStart) or activeMeasurementStart != trackedMeasurementStart
    trackedMeasurementStart := activeMeasurementStart
    trackedMeasurementHigh := high
    trackedMeasurementLow := low
else
    trackedMeasurementHigh := math.max(trackedMeasurementHigh, high)
    trackedMeasurementLow := math.min(trackedMeasurementLow, low)

// 保存最近一段历史中的每日早盘区间。
var array<int> sessionStarts = array.new<int>()
var array<int> sessionEnds = array.new<int>()
var array<float> sessionHighs = array.new<float>()
var array<float> sessionLows = array.new<float>()
var array<float> sessionMorningHighs = array.new<float>()
var array<float> sessionMorningLows = array.new<float>()
int maxStoredSessions = 500
int maxVisibleSessions = 20

if openingRangeStarted
    array.push(sessionStarts, time)
    array.push(sessionEnds, time_close)
    array.push(sessionHighs, high)
    array.push(sessionLows, low)
    array.push(sessionMorningHighs, trackedMeasurementHigh)
    array.push(sessionMorningLows, trackedMeasurementLow)

    if array.size(sessionStarts) > maxStoredSessions
        array.shift(sessionStarts)
        array.shift(sessionEnds)
        array.shift(sessionHighs)
        array.shift(sessionLows)
        array.shift(sessionMorningHighs)
        array.shift(sessionMorningLows)
else if inOpeningRange and array.size(sessionStarts) > 0
    int lastIndex = array.size(sessionStarts) - 1
    array.set(sessionEnds, lastIndex, time_close)
    array.set(sessionHighs, lastIndex, math.max(array.get(sessionHighs, lastIndex), high))
    array.set(sessionLows, lastIndex, math.min(array.get(sessionLows, lastIndex), low))

// 美盘区块创建后，继续累计至北京时间次日 12:00。
// 初始值已经包含美盘开盘当日 08:00 至开盘时刻的行情。
if array.size(sessionStarts) > 0
    int latestSessionIndex = array.size(sessionStarts) - 1
    int latestSessionStart = array.get(sessionStarts, latestSessionIndex)
    int latestMorningStart = sessionMorningStart(latestSessionStart)
    int latestDisplayEnd = sessionDisplayEnd(latestSessionStart)
    bool inMorningMeasurement = time >= latestMorningStart and time < latestDisplayEnd
    if inMorningMeasurement
        float storedMorningHigh = array.get(sessionMorningHighs, latestSessionIndex)
        float storedMorningLow = array.get(sessionMorningLows, latestSessionIndex)
        array.set(
             sessionMorningHighs,
             latestSessionIndex,
             na(storedMorningHigh) ? high : math.max(storedMorningHigh, high)
        )
        array.set(
             sessionMorningLows,
             latestSessionIndex,
             na(storedMorningLow) ? low : math.min(storedMorningLow, low)
        )

// 每次缩放或左右拖动图表后，删除旧对象并按当前视口重画。
var array<line> drawnLines = array.new<line>()
var array<box> drawnBoxes = array.new<box>()
var array<label> drawnLabels = array.new<label>()

if barstate.islast
    while array.size(drawnLines) > 0
        line.delete(array.pop(drawnLines))
    while array.size(drawnBoxes) > 0
        box.delete(array.pop(drawnBoxes))
    while array.size(drawnLabels) > 0
        label.delete(array.pop(drawnLabels))

    int storedCount = array.size(sessionStarts)
    int firstVisibleIndex = na
    int lastVisibleIndex = na

    // 一个区间从当天 09:30 ET 生效，到北京时间次日 12:00 结束。
    // 这样跨日时是两段独立横线，不会产生连接高低点的竖线。
    if storedCount > 0
        for index = 0 to storedCount - 1
            int candidateStart = array.get(sessionStarts, index)
            int candidateRight = sessionDisplayEnd(candidateStart)
            int candidateSessionDate = year(candidateStart, SESSION_TIMEZONE) * 10000
                 + month(candidateStart, SESSION_TIMEZONE) * 100
                 + dayofmonth(candidateStart, SESSION_TIMEZONE)
            bool matchesDisplayRange = showAllTradingDays
                 or candidateSessionDate == todaySessionDate
            bool overlapsViewport = candidateStart <= chart.right_visible_bar_time
                 and candidateRight >= chart.left_visible_bar_time
            if overlapsViewport and matchesDisplayRange
                if na(firstVisibleIndex)
                    firstVisibleIndex := index
                lastVisibleIndex := index

    if not na(firstVisibleIndex) and not na(lastVisibleIndex)
        firstVisibleIndex := math.max(firstVisibleIndex, lastVisibleIndex - maxVisibleSessions + 1)

        for index = firstVisibleIndex to lastVisibleIndex
            int selectedStart = array.get(sessionStarts, index)
            int selectedEnd = array.get(sessionEnds, index)
            int selectedDisplayEnd = sessionDisplayEnd(selectedStart)
            int segmentRight = math.min(selectedDisplayEnd, chart.right_visible_bar_time)
            float selectedHigh = array.get(sessionHighs, index)
            float selectedLow = array.get(sessionLows, index)
            float rangeHeight = selectedHigh - selectedLow
            float selectedMorningHigh = array.get(sessionMorningHighs, index)
            float selectedMorningLow = array.get(sessionMorningLows, index)
            float morningRangeHeight = selectedMorningHigh - selectedMorningLow
            bool hasHorizontalSpace = segmentRight > selectedStart
            bool canExtend = segmentRight > selectedEnd and rangeHeight > 0
            bool isLatestVisible = index == lastVisibleIndex
            int visibleLineLeft = math.max(selectedStart, chart.left_visible_bar_time)
            int mainLabelX = visibleLineLeft + int(math.round((segmentRight - visibleLineLeft) / 2.0))
            float rangeLabelY = selectedHigh - rangeHeight * 0.03
            float morningRangeLabelY = selectedHigh - rangeHeight * 0.06
            int visibleExtensionLeft = math.max(selectedEnd, chart.left_visible_bar_time)
            int extensionLabelX = visibleExtensionLeft + int(math.round((segmentRight - visibleExtensionLeft) / 2.0))

            color rangeColor = color.rgb(245, 158, 11)
            color upperColor = color.rgb(239, 107, 127)
            color lowerColor = color.rgb(75, 155, 216)

            if showOpeningRange and hasHorizontalSpace
                // 完整早盘矩形使用最终高低点，不随盘中高点形成阶梯或曲线。
                box openingBox = box.new(
                     left = selectedStart,
                     top = selectedHigh,
                     right = selectedEnd,
                     bottom = selectedLow,
                     xloc = xloc.bar_time,
                     border_color = rangeColor,
                     border_width = 1,
                     bgcolor = color.new(rangeColor, 82)
                )
                array.push(drawnBoxes, openingBox)

                if canExtend
                    box continuationBox = box.new(
                         left = selectedEnd,
                         top = selectedHigh,
                         right = segmentRight,
                         bottom = selectedLow,
                         xloc = xloc.bar_time,
                         border_color = na,
                         bgcolor = color.new(rangeColor, 95)
                    )
                    array.push(drawnBoxes, continuationBox)

                // 每天使用独立 line 对象，所以新旧区间之间不会出现竖向连接。
                line highLine = line.new(
                     x1 = selectedStart,
                     y1 = selectedHigh,
                     x2 = segmentRight,
                     y2 = selectedHigh,
                     xloc = xloc.bar_time,
                     color = rangeColor,
                     width = 1
                )
                line lowLine = line.new(
                     x1 = selectedStart,
                     y1 = selectedLow,
                     x2 = segmentRight,
                     y2 = selectedLow,
                     xloc = xloc.bar_time,
                     color = rangeColor,
                     width = 1
                )
                array.push(drawnLines, highLine)
                array.push(drawnLines, lowLine)

                if showRangeDifference and rangeHeight > 0
                    label rangeDifferenceLabel = label.new(
                         x = mainLabelX,
                         y = rangeLabelY,
                         text = "区间振幅：" + str.tostring(rangeHeight, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = color.white,
                         textalign = text.align_center,
                         size = size.small
                    )
                    array.push(drawnLabels, rangeDifferenceLabel)

                if showMorningDifference and not na(morningRangeHeight)
                    label morningDifferenceLabel = label.new(
                         x = mainLabelX,
                         y = morningRangeLabelY,
                         text = "今日振幅：" + str.tostring(morningRangeHeight, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = color.white,
                         textalign = text.align_center,
                         size = size.small
                    )
                    array.push(drawnLabels, morningDifferenceLabel)

                if showLabels and isLatestVisible
                    label highLabel = label.new(
                         x = mainLabelX,
                         y = selectedHigh,
                         text = str.tostring(selectedHigh, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = rangeColor,
                         textalign = text.align_center,
                         size = size.small
                    )
                    label lowLabel = label.new(
                         x = mainLabelX,
                         y = selectedLow,
                         text = str.tostring(selectedLow, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = rangeColor,
                         textalign = text.align_center,
                         size = size.small
                    )
                    array.push(drawnLabels, highLabel)
                    array.push(drawnLabels, lowLabel)

            if showUpperTargets and canExtend
                float upper1 = selectedHigh + rangeHeight
                float upper2 = selectedHigh + rangeHeight * 2.0

                box upperBand1 = box.new(
                     left = selectedEnd,
                     top = upper1,
                     right = segmentRight,
                     bottom = selectedHigh,
                     xloc = xloc.bar_time,
                     border_color = na,
                     bgcolor = color.new(upperColor, 95)
                )
                box upperBand2 = box.new(
                     left = selectedEnd,
                     top = upper2,
                     right = segmentRight,
                     bottom = upper1,
                     xloc = xloc.bar_time,
                     border_color = na,
                     bgcolor = color.new(upperColor, 97)
                )
                line upperLine1 = line.new(
                     x1 = selectedEnd,
                     y1 = upper1,
                     x2 = segmentRight,
                     y2 = upper1,
                     xloc = xloc.bar_time,
                     color = upperColor,
                     style = line.style_dashed
                )
                line upperLine2 = line.new(
                     x1 = selectedEnd,
                     y1 = upper2,
                     x2 = segmentRight,
                     y2 = upper2,
                     xloc = xloc.bar_time,
                     color = upperColor,
                     style = line.style_dashed
                )
                array.push(drawnBoxes, upperBand1)
                array.push(drawnBoxes, upperBand2)
                array.push(drawnLines, upperLine1)
                array.push(drawnLines, upperLine2)

                if showLabels and isLatestVisible
                    label upperLabel1 = label.new(
                         x = extensionLabelX,
                         y = upper1,
                         text = "+1×TR  " + str.tostring(upper1, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = upperColor,
                         textalign = text.align_center,
                         size = size.small
                    )
                    label upperLabel2 = label.new(
                         x = extensionLabelX,
                         y = upper2,
                         text = "+2×TR  " + str.tostring(upper2, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = upperColor,
                         textalign = text.align_center,
                         size = size.small
                    )
                    array.push(drawnLabels, upperLabel1)
                    array.push(drawnLabels, upperLabel2)

            if showLowerTargets and canExtend
                float lower1 = selectedLow - rangeHeight
                float lower2 = selectedLow - rangeHeight * 2.0

                box lowerBand1 = box.new(
                     left = selectedEnd,
                     top = selectedLow,
                     right = segmentRight,
                     bottom = lower1,
                     xloc = xloc.bar_time,
                     border_color = na,
                     bgcolor = color.new(lowerColor, 95)
                )
                box lowerBand2 = box.new(
                     left = selectedEnd,
                     top = lower1,
                     right = segmentRight,
                     bottom = lower2,
                     xloc = xloc.bar_time,
                     border_color = na,
                     bgcolor = color.new(lowerColor, 97)
                )
                line lowerLine1 = line.new(
                     x1 = selectedEnd,
                     y1 = lower1,
                     x2 = segmentRight,
                     y2 = lower1,
                     xloc = xloc.bar_time,
                     color = lowerColor,
                     style = line.style_dashed
                )
                line lowerLine2 = line.new(
                     x1 = selectedEnd,
                     y1 = lower2,
                     x2 = segmentRight,
                     y2 = lower2,
                     xloc = xloc.bar_time,
                     color = lowerColor,
                     style = line.style_dashed
                )
                array.push(drawnBoxes, lowerBand1)
                array.push(drawnBoxes, lowerBand2)
                array.push(drawnLines, lowerLine1)
                array.push(drawnLines, lowerLine2)

                if showLabels and isLatestVisible
                    label lowerLabel1 = label.new(
                         x = extensionLabelX,
                         y = lower1,
                         text = "-1×TR  " + str.tostring(lower1, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = lowerColor,
                         textalign = text.align_center,
                         size = size.small
                    )
                    label lowerLabel2 = label.new(
                         x = extensionLabelX,
                         y = lower2,
                         text = "-2×TR  " + str.tostring(lower2, format.mintick),
                         xloc = xloc.bar_time,
                         style = label.style_none,
                         textcolor = lowerColor,
                         textalign = text.align_center,
                         size = size.small
                    )
                    array.push(drawnLabels, lowerLabel1)
                    array.push(drawnLabels, lowerLabel2)
