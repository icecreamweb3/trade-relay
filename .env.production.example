# ============================================================
# Trade Relay - Production Environment Configuration Example
# Copy this file to .env.production and fill in your real values.
# This file is now the primary runtime env source.
# Legacy .env remains only as a compatibility fallback.
# Packaged Electron builds will also look for .env.production next to the exe
# or under the app resources directory.
# ============================================================

# ------------------------------------------------------------
# Backend listen address
# BACKEND_HOST: FastAPI bind host. Use 0.0.0.0 in containers/servers.
# BACKEND_PORT: FastAPI service port.
# BACKEND_LOG_LEVEL: uvicorn log level.
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# ------------------------------------------------------------
# Database connection (primary names used by the application)
# TRADE_RELAY_MYSQL_HOST: MySQL host or IP.
# TRADE_RELAY_MYSQL_PORT: MySQL port.
# TRADE_RELAY_MYSQL_USER: MySQL username.
# TRADE_RELAY_MYSQL_PASSWORD: MySQL password.
# TRADE_RELAY_MYSQL_DATABASE: MySQL database name.
# TRADE_RELAY_MYSQL_POOL_SIZE: number of reusable DB connections kept in process.
# TRADE_RELAY_OPERATION_LOG_QUEUE_SIZE: async operation log queue capacity.
# ------------------------------------------------------------
TRADE_RELAY_MYSQL_HOST=your-mysql-host
TRADE_RELAY_MYSQL_PORT=3306
TRADE_RELAY_MYSQL_USER=trade_relay
TRADE_RELAY_MYSQL_PASSWORD=change-me
TRADE_RELAY_MYSQL_DATABASE=trade_relay
TRADE_RELAY_MYSQL_POOL_SIZE=8
TRADE_RELAY_OPERATION_LOG_QUEUE_SIZE=1000

# ------------------------------------------------------------
# Security
# TRADE_RELAY_JWT_SECRET: JWT signing key for login sessions.
# TRADE_RELAY_ENCRYPTION_KEY: encryption key for stored Binance API credentials.
# JWT_EXPIRE_HOURS: token validity period in hours.
# ------------------------------------------------------------
TRADE_RELAY_JWT_SECRET=replace-with-a-long-random-string
TRADE_RELAY_ENCRYPTION_KEY=replace-with-a-base64-key
JWT_EXPIRE_HOURS=72

# ------------------------------------------------------------
# Global behavior
# TRADE_RELAY_LANG: application language, zh or en.
# TRADE_RELAY_BINANCE_TESTNET: true uses Binance testnet.
# TRADE_RELAY_MOCK_MODE: true disables real order submission.
# BINANCE_SYMBOL: default futures symbol shown in the UI.
# ------------------------------------------------------------
TRADE_RELAY_LANG=zh
TRADE_RELAY_BINANCE_TESTNET=false
TRADE_RELAY_MOCK_MODE=false
BINANCE_SYMBOL=BTCUSDC

# ------------------------------------------------------------
# Optional frontend / Electron backend routing
# TRADE_RELAY_API_BASE_URL: explicit backend base URL for Electron / frontend.
# BACKEND_PROXY_URL: proxy dedicated to Electron main-process backend API requests.
# BINANCE_LANG: override Binance page locale.
# UI_LANG: override renderer locale independently from TRADE_RELAY_LANG.
# ------------------------------------------------------------
TRADE_RELAY_API_BASE_URL=http://127.0.0.1:8000
# BACKEND_PROXY_URL=http://127.0.0.1:10809

# Optional MySQL proxy example
# TRADE_RELAY_MYSQL_PROXY_URL=socks5://127.0.0.1:10808
# BINANCE_LANG=zh-CN
# UI_LANG=zh-CN

# ------------------------------------------------------------
# Optional networking overrides
# BINANCE_BASE_URL: override Binance Futures REST endpoint.
# PROXY: HTTP/SOCKS proxy used by Binance-related requests.
# BINANCE_PROXY_URL: legacy Binance-specific proxy override.
# TRADE_RELAY_MYSQL_PROXY_URL: optional TCP proxy for MySQL connections.
#   Supports socks5://, socks5h://, socks4://, socks4a://, http://, https://
#   Example: socks5://127.0.0.1:10808
# ALL_PROXY / HTTPS_PROXY / HTTP_PROXY: system proxy variables.
# ------------------------------------------------------------
# BINANCE_BASE_URL=https://fapi.binance.com
# PROXY=http://your-proxy:7890
# BINANCE_PROXY_URL=http://your-proxy:7890
# TRADE_RELAY_MYSQL_PROXY_URL=socks5://127.0.0.1:10808
# ALL_PROXY=socks5://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809

