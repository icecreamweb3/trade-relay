# ============================================================
# Trade Relay – Configuration File
# ============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# .env is excluded from version control (.gitignore).
# ============================================================


# ------------------------------------------------------------
# 1. Display Language
#    zh  – Chinese (中文)   [default on Windows]
#    en  – English          [default on Linux / macOS]
#    Can also be overridden at runtime: python main.py --lang zh
# ------------------------------------------------------------
TRADE_RELAY_LANG=en


# ------------------------------------------------------------
# 2. Database – MySQL
#    Configure the MySQL connection parameters below.
#    Make sure the database and user are created in advance:
#
#      CREATE DATABASE trade_relay CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#      CREATE USER 'trade_relay'@'%' IDENTIFIED BY 'your_password';
#      GRANT ALL PRIVILEGES ON trade_relay.* TO 'trade_relay'@'%';
#      FLUSH PRIVILEGES;
# ------------------------------------------------------------
TRADE_RELAY_MYSQL_HOST=127.0.0.1
TRADE_RELAY_MYSQL_PORT=3306
TRADE_RELAY_MYSQL_USER=trade_relay
TRADE_RELAY_MYSQL_PASSWORD=your_password
TRADE_RELAY_MYSQL_DATABASE=trade_relay


# ------------------------------------------------------------
# 3. Admin Account (first-run bootstrap)
#    Credentials for the default admin account created on
#    the very first launch.  Ignored after the account exists.
# ------------------------------------------------------------
TRADE_RELAY_ADMIN_USERNAME=admin
TRADE_RELAY_ADMIN_PASSWORD=Admin@123


# ------------------------------------------------------------
# 4. Binance API – Default / Global Keys
#    These are used as a fallback when a per-user YAML config
#    does not specify its own keys.
#    Leave empty to rely entirely on per-user configuration.
# ------------------------------------------------------------
# TRADE_RELAY_BINANCE_API_KEY=
# TRADE_RELAY_BINANCE_API_SECRET=

# Set to true to use Binance Testnet instead of live trading.
TRADE_RELAY_BINANCE_TESTNET=false

# Set to true to run in mock mode (no real orders are sent).
TRADE_RELAY_MOCK_MODE=false


# ------------------------------------------------------------
# 5. UI / Qt
#    Override the Qt platform plugin (Linux only).
#    xcb  – X11 (recommended on Linux)
#    wayland – Wayland (experimental)
# ------------------------------------------------------------
# QT_QPA_PLATFORM=xcb
